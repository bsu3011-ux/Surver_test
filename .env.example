# ============================================================
# 어쩌다지식 AI YouTube Pipeline — 환경 변수 설정
# ============================================================
# 이 파일을 .env 로 복사하고 실제 값으로 채워주세요:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Anthropic (Claude API) — 스크립트 생성
# ------------------------------------------------------------
# https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ------------------------------------------------------------
# Google Cloud — 공통
# ------------------------------------------------------------
# GCP 서비스 계정 JSON 키 파일 경로
# 권한: TTS API, Vertex AI, Drive API, YouTube Data API
# 발급: GCP Console > IAM > 서비스 계정 > 키 추가
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# GCP 프로젝트 ID
# GCP Console 홈에서 확인 가능
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ------------------------------------------------------------
# Google Drive — 검토 영상 업로드 폴더
# ------------------------------------------------------------
# Google Drive에서 "어쩌다지식_검토대기" 폴더 생성 후
# 폴더 URL에서 ID 복사: drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_FOLDER_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs

# ------------------------------------------------------------
# Telegram Bot — 리뷰 알림 및 승인/반려
# ------------------------------------------------------------
# 1. Telegram에서 @BotFather 에게 /newbot 명령으로 봇 생성
# 2. 봇 토큰 복사 (예: 1234567890:ABCdefGhIjKlmNoPQRstuVWXyz)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIjKlmNoPQRstuVWXyz

# 3. 봇을 채널/그룹에 추가한 뒤 chat_id 확인:
#    https://api.telegram.org/bot{TOKEN}/getUpdates
# 개인 채팅이면 본인의 user_id (음수이면 그룹 채팅)
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------
# YouTube Data API — 영상 업로드
# ------------------------------------------------------------
# OAuth2 클라이언트 시크릿 (서비스 계정이 아닌 OAuth2 앱)
# GCP Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
# 유형: 데스크톱 앱으로 생성 후 JSON 다운로드
YOUTUBE_CLIENT_SECRETS_FILE=/path/to/client_secrets.json

# ------------------------------------------------------------
# 선택 사항 (기본값이 있음)
# ------------------------------------------------------------
# Vertex AI 리전 (기본: us-central1)
# VERTEX_AI_LOCATION=us-central1

# Imagen 모델 (기본: imagen-3.0-generate-001)
# IMAGEN_MODEL=imagen-3.0-generate-001

# TTS 음성 이름 (기본: ko-KR-Neural2-C)
# TTS_VOICE_NAME=ko-KR-Neural2-C

# 로그 레벨 (기본: INFO)
# LOG_LEVEL=INFO
